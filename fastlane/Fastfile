# FoundryX — TestFlight delivery.
# Auth is an App Store Connect API key supplied via env (never committed):
#   ASC_KEY_ID, ASC_ISSUER_ID, ASC_KEY_PATH  (path to AuthKey_<id>.p8)
# Our keys live at ~/.appstoreconnect/private_keys/ (47S3XFDK6D, TY9TX3FBAD) —
# use one with App Manager (or Admin) role; a notarization-only key can't upload.

default_platform(:ios)

def asc_api_key
  app_store_connect_api_key(
    key_id: ENV.fetch("ASC_KEY_ID"),
    issuer_id: ENV.fetch("ASC_ISSUER_ID"),
    key_filepath: File.expand_path(ENV.fetch("ASC_KEY_PATH")),
  )
end

platform :ios do
  # THE ONE DOCUMENTED ENTRYPOINT for the gate suite (review S7). Concourse's
  # `foundryx-ios-publish` test job calls `scripts/ci-gates.sh` directly; this lane is the
  # local/lane-based equivalent so the gates are not "gates only if a human types them".
  # `beta` runs it first — a build that cannot pass the gates does not reach TestFlight.
  desc "Run the permanent CI gates (package tests, CQRS invariants, iOS compiles, Release leak, flake, lint)."
  lane :gates do |options|
    phases = options[:phases] || ""
    sh("cd .. && bash scripts/ci-gates.sh #{phases}")
  end

  desc "Large-library perf budgets on a simulated iPhone (nav + churn-interleaved CQRS phase)."
  lane :perf do |options|
    device = options[:device] || "iPhone 17 Pro"
    n = options[:n] || 175
    sh("cd .. && bash scripts/sim-perf.sh '#{device}' #{n}")
  end

  desc "First run only: register the bundle id + create the App Store Connect app record."
  lane :register do
    produce(
      api_key: asc_api_key,
      app_identifier: "com.goforgeit.foundryx",
      app_name: "FoundryX",
      team_id: "ND7H73W8VZ",
    )
  end

  desc "Build FoundryX (Release, app-store) and upload to TestFlight."
  lane :beta do
    # Gate the ship. Set FX_SKIP_GATES=1 only for an emergency hotfix, and say so out loud.
    if ENV["FX_SKIP_GATES"] == "1"
      UI.important("FX_SKIP_GATES=1 — shipping WITHOUT the CI gates. This is a deliberate hole.")
    else
      gates
    end
    api_key = asc_api_key
    # Regenerate the Xcode project from project.yml (xcodeproj is gitignored).
    sh("cd .. && xcodegen generate")
    # Monotonic build number from commit count (override with BUILD_NUMBER=).
    build_number = ENV["BUILD_NUMBER"] || sh("cd .. && git rev-list --count HEAD").strip
    # Manual App Store signing — sign the archive DIRECTLY with the distribution
    # identity + App Store profile, so the build never needs a Development cert
    # (whose private key isn't on this machine). Profile "FoundryX MainApp Store xc"
    # is bound to com.goforgeit.foundryx + an Apple Distribution cert.
    profile = ENV["FX_PROFILE"] || "FoundryX MainApp Store xc"
    build_app(
      project: "FoundryX.xcodeproj",
      scheme: "FoundryX",
      configuration: "Release",
      export_method: "app-store",
      output_directory: "build",
      xcargs: "CODE_SIGN_STYLE=Manual " \
              "CODE_SIGN_IDENTITY=\"Apple Distribution\" " \
              "PROVISIONING_PROFILE_SPECIFIER=\"#{profile}\" " \
              "CURRENT_PROJECT_VERSION=#{build_number}",
      export_options: {
        signingStyle: "manual",
        provisioningProfiles: { "com.goforgeit.foundryx" => profile },
      },
    )
    upload_to_testflight(
      api_key: api_key,
      skip_waiting_for_build_processing: true,
    )
  end
end
