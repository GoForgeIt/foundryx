<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleDisplayName</key>
	<string>FoundryX</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsLocalNetworking</key>
		<true/>
	</dict>
	<key>NSBluetoothAlwaysUsageDescription</key>
	<string>FoundryX connects to your Omi wearable over Bluetooth to capture audio.</string>
	<key>NSLocalNetworkUsageDescription</key>
	<string>FoundryX connects to your Foundry door running on your computer over the local network.</string>
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>FoundryX notes where a conversation took place so each capture shows its location. Location is sampled only while you're using the app and stays on your devices.</string>
	<key>NSMicrophoneUsageDescription</key>
	<string>FoundryX captures audio from your Omi wearable.</string>
	<key>UIBackgroundModes</key>
	<array>
		<string>bluetooth-central</string>
		<string>audio</string>
	</array>
	<key>UILaunchScreen</key>
	<dict/>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<!-- M5 R1b remote sign-in config. Fill these to enable "Continue with
	     Google/Microsoft" + off-LAN connect (see the foundry track's
	     oauth-client-setup.md). EMPTY client ids = remote OFF, app stays LAN-direct.
	     You ALSO must add the OAuth redirect schemes to CFBundleURLTypes below:
	       Google:    com.googleusercontent.apps.<reversed-ios-client-id>
	       Microsoft: msauth.<this-app-bundle-id> -->
	<key>FoundryXOAuth</key>
	<dict>
		<!-- NOTE: this Google id is the existing FKM *Web* client (works for the
		     relay audience check + the desktop's loopback Google sign-in). The
		     phone's NATIVE Google flow needs a Google *iOS*-type client; until one
		     exists, Google sign-in on the phone will fail (Microsoft works). Swap
		     this for the iOS client id (and its reversed scheme below) to enable it. -->
		<key>GoogleIOSClientID</key>
		<string>449450484577-snm32nugh3ons4rjgr95tn5je6qfgrs4.apps.googleusercontent.com</string>
		<key>MicrosoftClientID</key>
		<string>b0b93eb1-413e-41e5-8a90-5e991e113b62</string>
		<key>MicrosoftTenant</key>
		<string>organizations</string>
		<key>GatewayHTTPURL</key>
		<string>http://34.57.104.157:8788</string>
		<key>RelayWSURL</key>
		<string>ws://34.57.104.157:8787</string>
	</dict>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLSchemes</key>
			<array>
				<!-- Google reversed-client-id scheme (becomes valid once GoogleIOSClientID
				     is an iOS-type client). -->
				<string>com.googleusercontent.apps.449450484577-snm32nugh3ons4rjgr95tn5je6qfgrs4</string>
				<!-- Microsoft (Entra) iOS redirect — works with app b0b93eb1 once a
				     "Mobile and desktop" redirect msauth.com.goforgeit.foundryx://auth
				     is added in Entra. -->
				<string>msauth.com.goforgeit.foundryx</string>
			</array>
		</dict>
	</array>
</dict>
</plist>
